# ============================================================
# إعدادات نظام إدارة قطع الغيار — Access Lion Warehouses
# ============================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك.
# NEVER share .env publicly — يحتوي على كلمات مرور حساسة.

# ─── الخادم ──────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# ─── قاعدة البيانات ──────────────────────────────────────────
# للشركات (متعدد المستخدمين): استخدم postgres أو mysql
# للتطوير المحلي فقط:         استخدم sqlite

DB_DIALECT=postgres

# إعدادات PostgreSQL / MySQL (للشركات)
DB_HOST=192.168.1.100
DB_PORT=5432
DB_NAME=spareparts_db
DB_USER=spareparts_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Connection Pool
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# SSL (اتركه false للشبكات الداخلية)
DB_SSL=false

# تفعيل سجل SQL (للتشخيص فقط — اتركه false في الإنتاج)
DB_LOGGING=false

# إعدادات SQLite (للتطوير المحلي فقط — لا تستخدم في الشركة)
# DB_DIALECT=sqlite
# DB_STORAGE=./data/spareparts.sqlite

# ─── المصادقة (JWT) ──────────────────────────────────────────
# غيّر هذه القيمة إلى سلسلة عشوائية طويلة (32+ حرف)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=8h

# ─── النسخ الاحتياطي ─────────────────────────────────────────
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30
# وقت النسخ (cron format): الافتراضي 2:00 صباحاً كل يوم
BACKUP_CRON=0 2 * * *
# المنطقة الزمنية للجدول
TZ=Asia/Riyadh

# ─── ميزات إضافية ────────────────────────────────────────────
ENABLE_SERIALIZED_UNITS=false
