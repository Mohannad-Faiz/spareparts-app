{
  "name": "spareparts-backend",
  "version": "2.0.0",
  "description": "Spare Parts Inventory & QR Code Management — Multi-User Network Edition",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seed.js",
    "setup:postgres": "node setup-postgres.js",
    "backup:now": "node -e \"require('./src/utils/backup').runBackup().then(()=>process.exit(0))\"",
    "backup:list": "node -e \"require('./src/utils/backup').listBackups().forEach(b=>console.log(b.file, b.sizeKB+'KB'))\"",
    "install:service": "node scripts/install-service.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.3",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
